# Root Environment Example
# Copy this to .env and fill in the values.
# NEVER commit .env to version control.

# ======================================================
# Supabase Configuration
# ======================================================

# Public project URL (safe to use in frontend too)
SUPABASE_URL="https://eanuqinjawpkvwfojygx.supabase.co"

# Anon / publishable key — safe to expose to browser clients
# Found in: Supabase Dashboard > Settings > API > Project API keys > anon public
SUPABASE_ANON_KEY="sb_publishable_K3HFffY3S3UfI-hyo4hCkw_OG_exVmA"

# Service role key — SERVER ONLY, never send to browser
# Found in: Supabase Dashboard > Settings > API > Project API keys > service_role secret
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# JWT secret — used to verify Supabase-issued access tokens on the backend
# Found in: Supabase Dashboard > Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET="your-jwt-secret-here"

# Direct DB connection (IPv4 Connection Pooler — verified working)
# Direct DB connection (IPv6 only, may not resolve on all networks):
# SUPABASE_DB_URL="postgresql://postgres:cb8RGs3vmAfB01HH@db.eanuqinjawpkvwfojygx.supabase.co:5432/postgres"
# IPv4 Connection Pooler (Recommended / Verified Working):
SUPABASE_DB_URL="postgresql://postgres.eanuqinjawpkvwfojygx:cb8RGs3vmAfB01HH@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# ======================================================
# FastAPI Backend Configuration
# ======================================================
PROJECT_NAME="MediVeR XR Backend"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS='["http://localhost:3000"]'

# ======================================================
# Next.js Frontend Configuration
# ======================================================
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"